		<region region-id="3442" left="384" top="12528.75" width="58.5" height="15.75" align-x="399" align-y="12540" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">λ</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>3.0588235294117649</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="428"/>
		</region>
		<region region-id="2954" left="0" top="12588.75" width="359.25" height="14.25" align-x="18.75" align-y="12600" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Найдем координату ζ, соответствующую максимальному напряжению:</p>
			</text>
		</region>
		<region region-id="3443" left="408" top="12600.75" width="59.25" height="15.75" align-x="423.75" align-y="12612" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">χ</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0.25095030636532484</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="429"/>
		</region>
		<region region-id="2961" left="0" top="12610.5" width="214.5" height="51.75" align-x="33" align-y="12648" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="max">ζ</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:mult/>
							<ml:id xml:space="preserve">l</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:id xml:space="preserve">ln</ml:id>
									<ml:apply>
										<ml:minus/>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:div/>
												<ml:apply>
													<ml:plus/>
													<ml:real>1</ml:real>
													<ml:id xml:space="preserve">λ</ml:id>
												</ml:apply>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">ln</ml:id>
												<ml:id xml:space="preserve">χ</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">ln</ml:id>
									<ml:id xml:space="preserve">χ</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>-0.16434231978799993</ml:real>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="430"/>
		</region>
		<region region-id="2963" left="252" top="12636.75" width="7.5" height="14.25" align-x="255" align-y="12648" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">м</p>
			</text>
		</region>
		<region region-id="2973" left="0" top="12666.75" width="282.75" height="17.25" align-x="8.25" align-y="12678" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Так как ζ<sub>max</sub>&lt;0, то принимаем ζ<sub>max</sub>=0 и z<sub>max</sub>=R<sub>к</sub>=0,175 м.</p>
			</text>
		</region>
		<region region-id="2975" left="0" top="12684.75" width="128.25" height="14.25" align-x="31.5" align-y="12696" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Напряжения растяжения:</p>
			</text>
		</region>
		<region region-id="2978" left="240" top="12744.75" width="13.5" height="14.25" align-x="246.75" align-y="12756" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Па</p>
			</text>
		</region>
		<region region-id="2976" left="0" top="12707.25" width="177" height="73.5" align-x="42.75" align-y="12762" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve" subscript="р3">σ</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">z</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">ρ</ml:id>
								<ml:apply>
									<ml:pow/>
									<ml:id xml:space="preserve">ω</ml:id>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:integral auto-algorithm="true" algorithm="adaptive"/>
								<ml:lambda>
									<ml:boundVars>
										<ml:id xml:space="preserve" subscript="1">z</ml:id>
									</ml:boundVars>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve" subscript="1">z</ml:id>
										<ml:apply>
											<ml:id xml:space="preserve" subscript="3">F</ml:id>
											<ml:id xml:space="preserve" subscript="1">z</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:lambda>
								<ml:bounds>
									<ml:id xml:space="preserve">z</ml:id>
									<ml:id xml:space="preserve" subscript="п">R</ml:id>
								</ml:bounds>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve" subscript="3">F</ml:id>
							<ml:id xml:space="preserve">z</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="431"/>
		</region>
		<region region-id="2980" left="0" top="12786.75" width="161.25" height="14.25" align-x="23.25" align-y="12798" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Значение напряжения на корне:</p>
			</text>
		</region>
		<region region-id="2995" left="6" top="12805.5" width="136.5" height="25.5" align-x="87" align-y="12822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:mult/>
						<ml:apply>
							<ml:id xml:space="preserve" subscript="р3">σ</ml:id>
							<ml:id xml:space="preserve" subscript="к">R</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:pow/>
							<ml:real>10</ml:real>
							<ml:real>-6</ml:real>
						</ml:apply>
					</ml:apply>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>206.61103852446553</ml:real>
					</result>
				</ml:eval>
			</math>
