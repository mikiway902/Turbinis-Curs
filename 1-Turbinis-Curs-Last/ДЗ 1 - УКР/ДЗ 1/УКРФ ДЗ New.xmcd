		</region>
		<region region-id="2999" left="186" top="12810.75" width="24" height="14.25" align-x="198" align-y="12822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">МПа</p>
			</text>
		</region>
		<region region-id="3004" left="6" top="13002" width="288.75" height="211.5" align-x="6" align-y="13002" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
