		<region region-id="3008" left="0" top="13218.75" width="123" height="14.25" align-x="34.5" align-y="13230" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Коэффициент разгрузки:</p>
			</text>
		</region>
		<region region-id="3009" left="0" top="13236.75" width="280.5" height="53.25" align-x="22.5" align-y="13266" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="3">β</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:symEval style="equals" hide-keywords="true" hide-lhs="false">
							<ml:apply>
								<ml:div/>
								<ml:parens>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:id xml:space="preserve" subscript="р3">σ</ml:id>
											<ml:id xml:space="preserve" subscript="к">R</ml:id>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:real>10</ml:real>
											<ml:real>-6</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:parens>
								<ml:parens>
									<ml:apply>
										<ml:mult/>
										<ml:id xml:space="preserve" subscript="max0">σ</ml:id>
										<ml:apply>
											<ml:pow/>
											<ml:real>10</ml:real>
											<ml:real>-6</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:parens>
							</ml:apply>
							<ml:command>
								<ml:sequence>
									<ml:id xml:space="preserve">explicit</ml:id>
									<ml:id xml:space="preserve">ALL</ml:id>
								</ml:sequence>
							</ml:command>
							<ml:symResult>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult style="auto-select"/>
											<ml:real>2.066</ml:real>
											<ml:apply>
												<ml:pow/>
												<ml:real>10</ml:real>
												<ml:real>8</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:real>10</ml:real>
											<ml:real>-6</ml:real>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:mult/>
										<ml:apply>
											<ml:mult style="auto-select"/>
											<ml:real>4.114</ml:real>
											<ml:apply>
												<ml:pow/>
												<ml:real>10</ml:real>
												<ml:real>8</ml:real>
											</ml:apply>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:real>10</ml:real>
											<ml:real>-6</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:symResult>
						</ml:symEval>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>0.50223801162976611</ml:real>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="435"/>
		</region>
		<region region-id="3014" left="0" top="13308.75" width="310.5" height="14.25" align-x="3.75" align-y="13320" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>"Почти" равнопрочная равномерно нагретая лопатка (4)</b>
				</p>
			</text>
		</region>
		<region region-id="3445" left="342" top="13308.75" width="108" height="20.25" align-x="369.75" align-y="13320" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="40">F</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:id xml:space="preserve" subscript="п">F</ml:id>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>80.2452</ml:real>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="436"/>
		</region>
		<region region-id="3016" left="0" top="13326.75" width="277.5" height="17.25" align-x="17.25" align-y="13338" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Радиус R<sub>3</sub>, после которого площадь постоянна (F<sub>4</sub>=F<sub>п</sub>):</p>
			</text>
		</region>
		<region region-id="3025" left="402" top="13326.75" width="15" height="14.25" align-x="408.75" align-y="13338" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">мм</p>
			</text>
		</region>
		<region region-id="3017" left="0" top="13348.5" width="414" height="45.75" align-x="25.5" align-y="13380" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="3">R</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:symEval style="equals" hide-keywords="true" hide-lhs="false">
							<ml:apply>
								<ml:sqrt/>
								<ml:apply>
									<ml:div/>
									<ml:apply>
										<ml:minus/>
										<ml:apply>
											<ml:pow/>
											<ml:id xml:space="preserve" subscript="к">R</ml:id>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:pow/>
												<ml:id xml:space="preserve" subscript="п">R</ml:id>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:id xml:space="preserve">ln</ml:id>
												<ml:id xml:space="preserve">χ</ml:id>
											</ml:apply>
										</ml:apply>
									</ml:apply>
									<ml:apply>
										<ml:minus/>
										<ml:real>1</ml:real>
										<ml:apply>
											<ml:id xml:space="preserve">ln</ml:id>
											<ml:id xml:space="preserve">χ</ml:id>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:apply>
							<ml:command>
								<ml:sequence>
									<ml:id xml:space="preserve">explicit</ml:id>
									<ml:id xml:space="preserve">ALL</ml:id>
								</ml:sequence>
							</ml:command>
							<ml:symResult>
								<ml:apply>
									<ml:sqrt/>
									<ml:apply>
										<ml:div/>
										<ml:apply>
											<ml:minus/>
											<ml:apply>
												<ml:pow/>
												<ml:real>0.175</ml:real>
												<ml:real>2</ml:real>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:pow/>
													<ml:real>0.345</ml:real>
													<ml:real>2</ml:real>
												</ml:apply>
												<ml:apply>
													<ml:id xml:space="preserve">ln</ml:id>
