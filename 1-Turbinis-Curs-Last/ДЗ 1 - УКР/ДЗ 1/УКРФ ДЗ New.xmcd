		<region region-id="2943" left="0" top="12192.75" width="247.5" height="14.25" align-x="38.25" align-y="12204" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Показательный закон изменения площади (3)</b>
				</p>
			</text>
		</region>
		<region region-id="2945" left="0" top="12210.75" width="299.25" height="14.25" align-x="14.25" align-y="12222" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Закон изменения площади в зависимости от координаты z:</p>
			</text>
		</region>
		<region region-id="2950" left="0" top="12234" width="126.75" height="45" align-x="36" align-y="12270" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve" subscript="3">F</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">z</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult/>
						<ml:apply>
							<ml:mult/>
							<ml:id xml:space="preserve" subscript="к">F</ml:id>
							<ml:apply>
								<ml:pow/>
								<ml:real>10</ml:real>
								<ml:real>-6</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:pow/>
							<ml:id xml:space="preserve">χ</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:minus/>
									<ml:id xml:space="preserve">z</ml:id>
									<ml:id xml:space="preserve" subscript="к">R</ml:id>
								</ml:apply>
								<ml:id xml:space="preserve">l</ml:id>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="425"/>
		</region>
		<region region-id="2965" left="180" top="12255.75" width="12" height="17.25" align-x="183" align-y="12270" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">м<sup>2</sup>
				</p>
			</text>
		</region>
		<region region-id="2952" left="6" top="12390" width="243" height="193.5" align-x="6" align-y="12390" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
