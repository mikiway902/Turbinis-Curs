		<region region-id="65" left="12" top="980.25" width="527.25" height="12" align-x="12" align-y="990" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Средняя теплоёмкость продуктов сгорания керосина при α и воздуха (α -&gt; ∞), Дж/(кг·К):</p>
			</text>
		</region>
		<region region-id="66" left="198" top="992.25" width="299.25" height="59.25" align-x="245.25" align-y="1008" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve" subscript="pm">c</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">T</ml:id>
							<ml:id xml:space="preserve">α</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:lessThan/>
								<ml:id xml:space="preserve">T</ml:id>
								<ml:real>700</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:real>1.2</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:real>2.25</ml:real>
															<ml:id xml:space="preserve">α</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:apply>
													<ml:pow/>
													<ml:real>10</ml:real>
													<ml:real>-5</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:minus/>
													<ml:id xml:space="preserve">T</ml:id>
													<ml:real>70</ml:real>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:real>0.236</ml:real>
									</ml:apply>
								</ml:parens>
								<ml:real>4187</ml:real>
							</ml:apply>
						</ml:ifThen>
						<ml:ifThen>
							<ml:apply>
								<ml:greaterOrEqual/>
								<ml:id xml:space="preserve">T</ml:id>
								<ml:real>700</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:mult/>
											<ml:apply>
												<ml:mult/>
												<ml:parens>
													<ml:apply>
														<ml:plus/>
														<ml:real>2.2</ml:real>
														<ml:apply>
															<ml:div/>
															<ml:real>1.25</ml:real>
															<ml:id xml:space="preserve">α</ml:id>
														</ml:apply>
													</ml:apply>
												</ml:parens>
												<ml:apply>
													<ml:pow/>
													<ml:real>10</ml:real>
													<ml:real>-5</ml:real>
												</ml:apply>
											</ml:apply>
											<ml:parens>
												<ml:apply>
													<ml:plus/>
													<ml:id xml:space="preserve">T</ml:id>
													<ml:real>450</ml:real>
												</ml:apply>
											</ml:parens>
										</ml:apply>
										<ml:real>0.218</ml:real>
									</ml:apply>
								</ml:parens>
								<ml:real>4187</ml:real>
							</ml:apply>
						</ml:ifThen>
					</ml:program>
				</ml:define>
			</math>
			<rendering item-idref="24"/>
		</region>
