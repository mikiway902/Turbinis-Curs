				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">возврат охлаждающего воздуха за 1-й ступенью</p>
			</text>
		</region>
		<region region-id="62" left="198" top="897" width="121.5" height="22.5" align-x="223.5" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
