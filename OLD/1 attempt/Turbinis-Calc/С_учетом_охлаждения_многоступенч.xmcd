		<region region-id="57" left="12" top="812.25" width="560.25" height="24" align-x="12" align-y="822" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Охлаждение: при T*г &gt; 1250 К охлаждаются лопатки 1-й ступени (g_охл = 5 %), иначе обдуваются только диски и корпус (1,5 %).</p>
			</text>
		</region>
		<region region-id="58" left="12" top="848.25" width="180" height="12" align-x="12" align-y="858" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">отбор воздуха на охлаждение</p>
			</text>
		</region>
		<region region-id="59" left="198" top="849" width="171" height="16.5" align-x="223.5" align-y="858" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="охл">g</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:id xml:space="preserve">if</ml:id>
							<ml:sequence>
								<ml:apply>
									<ml:greaterThan/>
									<ml:id xml:space="preserve" subscript="г">T</ml:id>
									<ml:real>1250</ml:real>
								</ml:apply>
								<ml:real>0.05</ml:real>
								<ml:real>0.015</ml:real>
							</ml:sequence>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<ml:real>0.015</ml:real>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="22"/>
		</region>
		<region region-id="60" left="198" top="866.25" width="354.75" height="12" align-x="198" align-y="876" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<i>оценка: диски и корпус 1...2 %, охлаждаемые лопатки 3...7 %; схема - по [3]</i>
				</p>
			</text>
		</region>
		<region region-id="61" left="12" top="902.25" width="180" height="24" align-x="12" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
