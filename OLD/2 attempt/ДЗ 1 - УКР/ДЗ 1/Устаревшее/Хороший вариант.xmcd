	<regions>
		<region region-id="4" left="12" top="6.75" width="341.25" height="21.75" align-x="25.5" align-y="24" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f size="18">
						<b>Расчёт геометрических характеристик</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="23" left="6" top="35.25" width="65.25" height="15.75" align-x="7.5" align-y="48" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f size="14">
						<b>1-ый этап</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="24" left="6" top="56.25" width="439.5" height="24" align-x="21.75" align-y="66" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Любым из доступных вам способов перенести чертежи лопаток в автокад. При этом необходимо следить 1) за масштабом и 2) за углом установки </p>
			</text>
		</region>
		<region region-id="25" left="6" top="89.25" width="62.25" height="15.75" align-x="7.5" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f size="14">
						<b>2-ой этап</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="566" left="414" top="102" width="540" height="258.75" align-x="414" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<picture>
				<png item-idref="1" display-width="538.5" display-height="257.25"/>
			</picture>
			<rendering item-idref="2"/>
		</region>
		<region region-id="26" left="6" top="110.25" width="448.5" height="36" align-x="27.75" align-y="120" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Повернуть лопатку так, чтобы хорда была расположена горизонтально. Обрщаю внимание, что это не просто на 90 градусов относительно прошлого этапа, это поворот на соответсвующий угол установки. </p>
			</text>
		</region>
		<region region-id="27" left="6" top="155.25" width="62.25" height="15.75" align-x="7.5" align-y="168" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<f size="14">
						<b>3-ий этап</b>
					</f>
				</p>
			</text>
		</region>
		<region region-id="28" left="6" top="176.25" width="444.75" height="24" align-x="27.75" align-y="186" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Вписать лопатку в прямоугольник . Через середины сторон прямоугольника провести параллельные сторонам линии. Замерить величины а1 и а2.</p>
			</text>
		</region>
		<region region-id="168" left="6" top="206.25" width="85.5" height="12" align-x="25.5" align-y="216" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
