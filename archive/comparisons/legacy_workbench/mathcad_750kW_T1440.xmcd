		<region region-id="1597" left="36.67924" top="14491.7" width="242.4906" height="10.86792" align-x="57.73585" align-y="14500.53" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Кольцевая площадь сечения перед рабочими лопатками:</p>
			</text>
		</region>
		<region region-id="1598" left="36.67924" top="14517.51" width="130.4151" height="20.37736" align-x="67.24529" align-y="14531.09" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1СА">A</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">π</ml:id>
								<ml:id xml:space="preserve" subscript="1">D</ml:id>
