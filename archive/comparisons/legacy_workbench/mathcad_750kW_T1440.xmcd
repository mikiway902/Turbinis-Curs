			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Действительная статическая температура за СА:</p>
			</text>
		</region>
		<region region-id="1571" left="36.67924" top="14054.94" width="178.6415" height="38.03773" align-x="66.56604" align-y="14078.72" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1СА">T</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:minus/>
							<ml:id xml:space="preserve" subscript="гг">T*</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="с1">H</ml:id>
									<ml:apply>
										<ml:pow/>
										<ml:id xml:space="preserve" subscript="1">φ</ml:id>
										<ml:real>2</ml:real>
									</ml:apply>
								</ml:apply>
								<ml:id xml:space="preserve" subscript="p1">c</ml:id>
							</ml:apply>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<unitedValue>
								<ml:real>1065.1662133125553</ml:real>
								<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
									<unitReference unit="kelvin"/>
								</unitMonomial>
							</unitedValue>
						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="297"/>
		</region>
		<region region-id="1574" left="18.33962" top="14100.45" width="228.2264" height="10.86792" align-x="43.4717" align-y="14109.28" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
