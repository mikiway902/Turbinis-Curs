								<unitMonomial xmlns="http://schemas.mathsoft.com/units10">
									<unitReference unit="kilogram" power-numerator="-1"/>
									<unitReference unit="meter" power-numerator="3"/>
								</unitMonomial>
							</unitedValue>
						</result>
					</ml:eval>
				</ml:define>
			</math>
