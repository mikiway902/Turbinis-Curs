		<region region-id="1654" left="30.56604" top="14876.83" width="151.4717" height="10.86792" align-x="62.49057" align-y="14885.66" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Располагакмый теплоперепад в РК:</p>
			</text>
		</region>
		<region region-id="1655" left="24.45283" top="14901.96" width="185.434" height="36" align-x="47.54717" align-y="14922.34" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1л">H</ml:id>
