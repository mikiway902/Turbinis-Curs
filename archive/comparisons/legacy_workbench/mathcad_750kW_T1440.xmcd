		<region region-id="1618" left="36.67924" top="14558.94" width="117.5094" height="10.86792" align-x="50.26415" align-y="14567.77" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Осевая скорость перед РК:</p>
			</text>
		</region>
		<region region-id="1619" left="36.67924" top="14579.32" width="140.6038" height="33.28302" align-x="57.0566" align-y="14598.34" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1а">c</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:div/>
							<ml:parens>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve" subscript="т">G</ml:id>
									<ml:id xml:space="preserve" subscript="1СА">ν</ml:id>
								</ml:apply>
