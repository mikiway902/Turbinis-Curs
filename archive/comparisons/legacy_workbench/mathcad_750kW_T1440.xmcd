				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Температура конца идеального расширения в СА:</p>
			</text>
		</region>
		<region region-id="1576" left="36.67924" top="14126.94" width="164.3774" height="33.28302" align-x="71.32076" align-y="14145.96" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1СА1">T</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:minus/>
							<ml:id xml:space="preserve" subscript="гг">T*</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve" subscript="с1">H</ml:id>
								<ml:id xml:space="preserve" subscript="p1">c</ml:id>
							</ml:apply>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
							<unitedValue>
