						</result>
					</ml:eval>
				</ml:define>
			</math>
			<rendering item-idref="305"/>
		</region>
		<region region-id="1647" left="42.79245" top="14687.32" width="55.01887" height="15.62264" align-x="65.8868" align-y="14696.15" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="11">α</ml:id>
					<ml:apply>
						<ml:mult style="auto-select"/>
						<ml:real>18</ml:real>
						<ml:id xml:space="preserve">deg</ml:id>
