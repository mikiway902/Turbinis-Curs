				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Проверка угла выхода из СА:</p>
			</text>
		</region>
		<region region-id="1645" left="42.79245" top="14646.57" width="116.1509" height="33.28302" align-x="65.8868" align-y="14665.58" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define warning="WarnRedefinedUDScalar" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="11">α</ml:id>
					<ml:eval placeholderMultiplicationStyle="default">
						<ml:apply>
							<ml:id xml:space="preserve">asin</ml:id>
							<ml:apply>
								<ml:div/>
								<ml:id xml:space="preserve" subscript="1а">c</ml:id>
								<ml:id xml:space="preserve" subscript="1">c</ml:id>
							</ml:apply>
						</ml:apply>
						<result xmlns="http://schemas.mathsoft.com/math30">
