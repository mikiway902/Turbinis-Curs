		<region region-id="56" left="320.0" top="761.1" width="235.0" height="39.0" align-x="320.0" align-y="771.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"><i>[2] стр. 17: ТВД в полёте 0,67...0,77, стац. ГТУ 0,18...0,33; на стенде принято по c_т турбины</i></p></text></region>
		<region region-id="57" left="12.0" top="810.1" width="560.0" height="26.0" align-x="12.0" align-y="820.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Охлаждение: при T*г &gt; 1250 К охлаждаются лопатки 1-й ступени (g_охл = 5 %), иначе обдуваются только диски и корпус (1,5 %).</p></text></region>
		<region region-id="58" left="12.0" top="846.1" width="180.0" height="13.0" align-x="12.0" align-y="856.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">отбор воздуха на охлаждение</p></text></region>
		<region region-id="59" left="200.0" top="844.1" width="268.0" height="16.0" align-x="200.0" align-y="856.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define xmlns:ml="http://schemas.mathsoft.com/math30"><ml:id xml:space="preserve" subscript="охл">g</ml:id><ml:eval><ml:apply><ml:id xml:space="preserve">if</ml:id><ml:sequence><ml:apply><ml:greaterThan/><ml:id xml:space="preserve" subscript="г">T</ml:id><ml:real>1250</ml:real></ml:apply><ml:real>0.05</ml:real><ml:real>0.015</ml:real></ml:sequence></ml:apply></ml:eval></ml:define></math></region>
		<region region-id="60" left="200.0" top="864.1" width="355.0" height="26.0" align-x="200.0" align-y="874.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"><i>оценка: диски и корпус 1...2 %, охлаждаемые лопатки 3...7 %; схема - по [3]</i></p></text></region>
		<region region-id="61" left="12.0" top="900.1" width="180.0" height="26.0" align-x="12.0" align-y="910.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">возврат охлаждающего воздуха за 1-й ступенью</p></text></region>
		<region region-id="62" left="200.0" top="900.1" width="186.0" height="14.0" align-x="200.0" align-y="910.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define xmlns:ml="http://schemas.mathsoft.com/math30"><ml:id xml:space="preserve" subscript="воз">g</ml:id><ml:eval><ml:apply><ml:mult/><ml:real>0.6</ml:real><ml:id xml:space="preserve" subscript="охл">g</ml:id></ml:apply></ml:eval></ml:define></math></region>
		<region region-id="63" left="200.0" top="918.1" width="355.0" height="13.0" align-x="200.0" align-y="928.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"><i>оценка: 60 % охлаждающего воздуха возвращается в поток</i></p></text></region>
		<region region-id="64" left="12.0" top="955.1" width="560.0" height="15.6" align-x="12.0" align-y="965.1" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"><f size="12"><b>ЭТАП 2. СВОЙСТВА РАБОЧЕГО ТЕЛА (методичка, прил. 6)</b></f></p></text></region>
		<region region-id="65" left="12.0" top="978.7" width="527.0" height="13.0" align-x="12.0" align-y="988.7" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><text use-page-width="false" push-down="false" lock-width="true"><p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Средняя теплоёмкость продуктов сгорания керосина при α и воздуха (α -&gt; ∞), Дж/(кг·К):</p></text></region>
		<region region-id="66" left="200.0" top="999.7" width="452.8" height="82.0" align-x="200.0" align-y="1009.7" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag=""><math optimize="false" disable-calc="false"><ml:define xmlns:ml="http://schemas.mathsoft.com/math30"><ml:function><ml:id xml:space="preserve" subscript="pm">c</ml:id><ml:boundVars><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">α</ml:id></ml:boundVars></ml:function><ml:program><ml:ifThen><ml:apply><ml:lessThan/><ml:id xml:space="preserve">T</ml:id><ml:real>700</ml:real></ml:apply><ml:apply><ml:mult/><ml:parens><ml:apply><ml:plus/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:parens><ml:apply><ml:plus/><ml:real>1.2</ml:real><ml:apply><ml:div/><ml:real>2.25</ml:real><ml:id xml:space="preserve">α</ml:id></ml:apply></ml:apply></ml:parens><ml:apply><ml:pow/><ml:real>10</ml:real><ml:real>-5</ml:real></ml:apply></ml:apply><ml:parens><ml:apply><ml:minus/><ml:id xml:space="preserve">T</ml:id><ml:real>70</ml:real></ml:apply></ml:parens></ml:apply><ml:real>0.236</ml:real></ml:apply></ml:parens><ml:real>4187</ml:real></ml:apply></ml:ifThen><ml:ifThen><ml:apply><ml:greaterOrEqual/><ml:id xml:space="preserve">T</ml:id><ml:real>700</ml:real></ml:apply><ml:apply><ml:mult/><ml:parens><ml:apply><ml:plus/><ml:apply><ml:mult/><ml:apply><ml:mult/><ml:parens><ml:apply><ml:plus/><ml:real>2.2</ml:real><ml:apply><ml:div/><ml:real>1.25</ml:real><ml:id xml:space="preserve">α</ml:id></ml:apply></ml:apply></ml:parens><ml:apply><ml:pow/><ml:real>10</ml:real><ml:real>-5</ml:real></ml:apply></ml:apply><ml:parens><ml:apply><ml:plus/><ml:id xml:space="preserve">T</ml:id><ml:real>450</ml:real></ml:apply></ml:parens></ml:apply><ml:real>0.218</ml:real></ml:apply></ml:parens><ml:real>4187</ml:real></ml:apply></ml:ifThen></ml:program></ml:define></math></region>
